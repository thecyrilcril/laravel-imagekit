includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 7
    paths:
        - src
    tmpDir: build/phpstan

    # Illuminate\Image shipped in Laravel 13.20, and this package also supports
    # Laravel 12 where it does not exist. Rather than ignore the resulting
    # "unknown class" errors — which would silence real mistakes in the same
    # file — the stub declares the surface the compressor uses, so those calls
    # stay type-checked on both Laravel versions. PHPStan prefers the real
    # classes when they are installed.
    scanFiles:
        - stubs/illuminate-image.stub
